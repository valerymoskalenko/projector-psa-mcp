<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Projector.Application\Projector.Application.csproj" />
    <ProjectReference Include="..\Projector.ApiClient\Projector.ApiClient.csproj" />
    <ProjectReference Include="..\Projector.Contracts\Projector.Contracts.csproj" />
    <ProjectReference Include="..\Projector.Domain\Projector.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
