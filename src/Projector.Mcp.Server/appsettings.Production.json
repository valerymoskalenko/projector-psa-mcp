{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Projector": {
    "ClientIdSecretName": "ProjectorPSAOauthClientID",
    "ClientSecretSecretName": "ProjectorPSAOauthSecret",
    "JwtSigningKeySecretName": "ProjectorMcpJwtSigningKey",
    "TokenEncryptionKeySecretName": "ProjectorTokenEncryptionKey",
    "McpScope": "projector.mcp",
    "McpAudience": "projector-mcp",
    "RequestedScopes": "allowFullPermissions",
    "UseSqlTokenStore": true,
    "AllowedMcpRedirectUris": [
      "https://teams.microsoft.com/api/platform/v1.0/oAuthRedirect",
      "https://claude.ai/api/mcp/auth_callback",
      "https://claude.com/api/mcp/auth_callback",
      "https://vscode.dev/redirect"
    ],
    "AllowedOrigins": [
      "null"
    ]
  }
}
